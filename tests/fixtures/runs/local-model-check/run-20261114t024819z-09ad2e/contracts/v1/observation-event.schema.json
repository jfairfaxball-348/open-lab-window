{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-lab:schema:observation-event:v1",
  "title": "Observation event",
  "description": "One line of a run's append-only event log. Written only by privileged infrastructure outside the agent's writable environment; the agent can never author, edit or delete an event. Events record what was observably done or said, never inferred mental states.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "event_id",
    "experiment_id",
    "run_id",
    "seq",
    "timestamp",
    "recorder",
    "type",
    "epistemic_status",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "open-lab/observation-event" },
    "schema_version": { "$ref": "urn:open-lab:schema:common:v1#/$defs/schema_version_v1" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "experiment_id": { "$ref": "urn:open-lab:schema:common:v1#/$defs/slug" },
    "run_id": { "$ref": "urn:open-lab:schema:common:v1#/$defs/slug" },
    "seq": {
      "description": "Monotonic sequence within the run, starting at 0 with no gaps. The authoritative ordering.",
      "type": "integer",
      "minimum": 0
    },
    "timestamp": { "$ref": "urn:open-lab:schema:common:v1#/$defs/timestamp" },
    "monotonic_ms": {
      "description": "Milliseconds since run start on a monotonic clock. Survives wall-clock adjustments.",
      "type": "integer",
      "minimum": 0
    },
    "recorder": {
      "description": "The privileged component that wrote the event. There is deliberately no 'agent' value.",
      "enum": ["experiment_manager", "supervisor", "agent_runtime", "tool_host", "model_gateway"]
    },
    "actor": {
      "description": "Who performed the recorded action.",
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["agent", "system", "supervisor", "human_operator"] },
        "model_id": { "$ref": "urn:open-lab:schema:common:v1#/$defs/slug" },
        "provider_id": { "$ref": "urn:open-lab:schema:common:v1#/$defs/slug" }
      }
    },
    "type": {
      "enum": [
        "run.state_changed",
        "agent.output",
        "agent.statement",
        "model.call",
        "tool.call",
        "tool.result",
        "artifact.created",
        "artifact.modified",
        "artifact.deleted",
        "memory.written",
        "checkpoint.created",
        "error",
        "recovery",
        "resource.sample",
        "supervisor.action"
      ]
    },
    "epistemic_status": {
      "description": "'observed': infrastructure directly witnessed the fact. 'agent_claim': the content is something the model asserted about itself or the world; only the fact that it was said is evidence. 'derived': computed by infrastructure from other events, which must be listed in derived_from.",
      "enum": ["observed", "agent_claim", "derived"]
    },
    "derived_from": {
      "description": "Sequence numbers of the source events.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "correlation_id": {
      "description": "Links related events, e.g. a tool.result to its tool.call.",
      "type": "string",
      "minLength": 1
    },
    "prev_event_sha256": {
      "description": "Digest of the previous event's canonical JSON, forming a tamper-evident chain. Absent on seq 0.",
      "$ref": "urn:open-lab:schema:common:v1#/$defs/sha256"
    },
    "payload": { "type": "object" },
    "extensions": { "$ref": "urn:open-lab:schema:common:v1#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "agent.statement" } } },
      "then": { "properties": { "epistemic_status": { "const": "agent_claim" } } },
      "else": { "properties": { "epistemic_status": { "enum": ["observed", "derived"] } } }
    },
    {
      "if": { "properties": { "epistemic_status": { "const": "derived" } } },
      "then": { "required": ["derived_from"] }
    },
    {
      "if": { "properties": { "type": { "const": "run.state_changed" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["to"],
            "properties": {
              "from": { "$ref": "#/$defs/run_state" },
              "to": { "$ref": "#/$defs/run_state" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.output" } } },
      "then": {
        "properties": {
          "payload": {
            "description": "Text the orchestrator model emitted, verbatim. Hidden reasoning traces are not recorded.",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" },
              "truncated": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "agent.statement" } } },
      "then": {
        "properties": {
          "payload": {
            "description": "A goal, plan or self-description the agent explicitly stated. Recorded as a claim, not as a fact about internal state.",
            "required": ["kind", "text"],
            "properties": {
              "kind": { "enum": ["goal", "plan", "belief", "self_description", "other"] },
              "text": { "type": "string" },
              "source_seq": {
                "description": "The agent.output or tool.call event in which the statement appeared.",
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "model.call" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["model_id"],
            "properties": {
              "model_id": { "$ref": "urn:open-lab:schema:common:v1#/$defs/slug" },
              "purpose": { "enum": ["orchestration", "tool"] },
              "input_tokens": { "type": "integer", "minimum": 0 },
              "output_tokens": { "type": "integer", "minimum": 0 },
              "duration_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.call" } } },
      "then": {
        "required": ["correlation_id"],
        "properties": {
          "payload": {
            "required": ["capability_id", "arguments"],
            "properties": {
              "capability_id": { "$ref": "urn:open-lab:schema:common:v1#/$defs/slug" },
              "capability_version": { "$ref": "urn:open-lab:schema:common:v1#/$defs/semver" },
              "arguments": { "type": "object" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool.result" } } },
      "then": {
        "required": ["correlation_id"],
        "properties": {
          "payload": {
            "required": ["status"],
            "properties": {
              "status": { "enum": ["ok", "error", "timeout", "denied"] },
              "result": { "type": "object" },
              "error": { "type": "string" },
              "duration_ms": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["artifact.created", "artifact.modified", "artifact.deleted"] }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": ["artifact_id", "path"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "path": { "$ref": "urn:open-lab:schema:common:v1#/$defs/relative_path" },
              "sha256": { "$ref": "urn:open-lab:schema:common:v1#/$defs/sha256" },
              "size_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "checkpoint.created" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["checkpoint_id"],
            "properties": { "checkpoint_id": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["origin", "message"],
            "properties": {
              "origin": { "enum": ["agent_runtime", "tool", "model", "supervisor", "host"] },
              "message": { "type": "string" },
              "recoverable": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "recovery" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["action"],
            "properties": {
              "action": { "enum": ["retry", "restart_runtime", "resume_from_checkpoint", "abandon"] },
              "checkpoint_id": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "resource.sample" } } },
      "then": {
        "properties": {
          "payload": {
            "minProperties": 1,
            "properties": {
              "cpu_percent": { "type": "number", "minimum": 0 },
              "ram_mb": { "type": "number", "minimum": 0 },
              "vram_mb": { "type": "number", "minimum": 0 },
              "workspace_disk_mb": { "type": "number", "minimum": 0 },
              "process_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "supervisor.action" } } },
      "then": {
        "properties": {
          "recorder": { "const": "supervisor" },
          "payload": {
            "required": ["action"],
            "properties": {
              "action": {
                "enum": [
                  "limit_enforced",
                  "permission_denied",
                  "deadline_notice",
                  "paused",
                  "resumed",
                  "terminated"
                ]
              },
              "detail": { "type": "string" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "run_state": {
      "enum": [
        "created",
        "starting",
        "running",
        "paused",
        "stopping",
        "recovering",
        "completed",
        "terminated",
        "failed"
      ]
    }
  }
}
